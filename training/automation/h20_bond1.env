# Example NCCL/GLOO environment for one training cluster (eight H20 GPUs per host,
# bond1 as the RoCE interface). Passed with --env-file; adjust the interface names,
# IB HCA list, and NCCL_DEBUG settings to match your own nodes.
NCCL_SOCKET_IFNAME=bond1
GLOO_SOCKET_IFNAME=bond1
NCCL_IB_DISABLE=0
NCCL_IB_GID_INDEX=3
NCCL_IB_HCA=mlx5_bond_1,mlx5_bond_5,mlx5_bond_3,mlx5_bond_7,mlx5_bond_4,mlx5_bond_8,mlx5_bond_2,mlx5_bond_6
CUDA_DEVICE_MAX_CONNECTIONS=1
NCCL_NET_GDR_LEVEL=2
NCCL_NET_GDR_READ=1
NCCL_IB_QPS_PER_CONNECTION=4
NCCL_IB_TC=160
NCCL_PXN_DISABLE=0
NCCL_IB_TIMEOUT=22
NCCL_ASYNC_ERROR_HANDLING=1
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
TORCH_NCCL_BLOCKING_WAIT=1
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET
